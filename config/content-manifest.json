{
  "schema_version": 2,
  "theme_policy": {
    "minimum_question_count": 25,
    "minimum_difficulty_distribution": {
      "junior": 5,
      "middle": 10,
      "senior": 5,
      "staff": 5
    },
    "count_semantics": "floor",
    "rationale": "The coverage target is a floor, not a cap. A complete Theme carries at least 25 active Questions and at least the baseline count in every difficulty band. Themes that legitimately grew past the baseline through certification or roadmap coverage keep that material instead of discarding verified Questions to satisfy an exact count."
  },
  "lab_policy": {
    "minimum_labs_per_theme": 1,
    "count_semantics": "floor",
    "enforcement": "declared-themes-only",
    "rationale": "Labs are corpus material on the same terms as Questions (issue 191), so their coverage belongs in this manifest rather than in anyone's memory. The count is a floor: a Theme that declares lab coverage carries at least minimum_labs_per_theme, and growing past that is welcome. Enforcement is declared-themes-only because 30 of the 40 Themes carry no Lab yet; a floor applied to all of them would fail the build today and teach everyone to ignore it. A Theme opts in by setting labs to complete, and from that moment the floor is enforced and cannot silently regress. The reverse is enforced too: a Theme with Labs on disk must declare them, so coverage cannot drift in either direction."
  },
